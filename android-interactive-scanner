### Phase 7 Integrity Verification Script
Run this validation script against the generated `ArchitectureDocumentationModel` before finishing:

```bash
npx tsx -e "
import { ARCHITECTURE_DOCUMENTATION } from './src/data/flowsData.ts';
const { components, flows } = ARCHITECTURE_DOCUMENTATION;
let errors = 0;
for (const flow of flows) {
  const nodeIds = new Set(flow.nodes.map(n => n.componentId));
  if (!nodeIds.has(flow.entryPointId)) { console.error('Invalid entryPoint:', flow.id); errors++; }
  for (const exitId of flow.exitPointIds) {
    if (!nodeIds.has(exitId)) { console.error('Invalid exitPoint:', flow.id, exitId); errors++; }
  }
  for (const n of flow.nodes) {
    if (!components[n.componentId]) { console.error('Missing component:', n.componentId); errors++; }
  }
  for (const e of flow.edges) {
    if (!nodeIds.has(e.source) || !nodeIds.has(e.target)) { console.error('Orphan edge:', flow.id, e.id); errors++; }
    if (!e.calls || e.calls.length === 0) { console.error('Edge without calls:', flow.id, e.id); errors++; }
  }
}
if (errors > 0) process.exit(1);
console.log('Validation passed. Flows:', flows.length, 'Components:', Object.keys(components).length);
"
```

